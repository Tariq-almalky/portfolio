<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#0C0C0F;
    --surface:#141417;
    --line: rgba(242,241,236,0.09);
    --line-strong: rgba(242,241,236,0.16);
    --text:#F2F1EC;
    --text-dim:#9C978D;
    --accent:#C9A24B;
    --max: 720px;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    background:
      radial-gradient(ellipse at top, rgba(201,162,75,0.05), transparent 55%),
      var(--bg);
    color:var(--text);
    font-family:'Inter', sans-serif;
    font-size:16px;
    line-height:1.65;
    -webkit-font-smoothing:antialiased;
  }
  a{color:var(--text); text-decoration-color: var(--accent); text-underline-offset:3px;}
  a:hover{ color:var(--accent); }
  .wrap{max-width:var(--max); margin:0 auto; padding: 0 24px 90px;}

  header.hero{
    max-width:var(--max);
    margin: 90px auto 0;
    padding: 0 24px;
  }
  .kicker{
    font-family:'JetBrains Mono', monospace;
    font-size:12px;
    letter-spacing:0.08em;
    color:var(--accent);
    margin:0 0 18px;
  }
  h1{
    font-family:'Fraunces', serif;
    font-weight:500;
    font-size: clamp(36px, 8vw, 54px);
    line-height:1.08;
    letter-spacing:-0.01em;
    margin:0 0 16px;
    color:var(--text);
  }
  .role{
    font-size:17.5px;
    color:var(--text-dim);
    margin:0 0 26px;
    max-width:50ch;
  }
  .accent-rule{
    height:1px;
    width:0;
    background: var(--accent);
    animation: draw 1.2s cubic-bezier(.2,.7,.2,1) 0.15s forwards;
  }
  @keyframes draw{ to{ width:64px; } }
  @media (prefers-reduced-motion: reduce){
    .accent-rule{ animation:none; width:64px; }
  }
  .meta-line{
    margin-top:22px;
    display:flex;
    flex-wrap:wrap;
    gap:6px 10px;
    font-family:'JetBrains Mono', monospace;
    font-size:12.5px;
    color:var(--text-dim);
  }
  .meta-line span.dot{ color:var(--line-strong); }

  section{ margin-top:72px; }
  .sec-head{
    margin-bottom:22px;
  }
  h2{
    font-family:'Fraunces', serif;
    font-weight:500;
    font-size:24px;
    margin:0 0 10px;
    color:var(--text);
  }
  .sec-line{
    height:1px;
    width:100%;
    background:var(--line);
  }
  p.lead{
    color:var(--text-dim);
    max-width:60ch;
    font-size:16px;
  }

  .legend{ border-top:1px solid var(--line); }
  .legend-row{
    display:grid;
    grid-template-columns: 180px 1fr;
    border-bottom:1px solid var(--line);
    padding:16px 0;
  }
  .legend-key{
    font-family:'JetBrains Mono', monospace;
    font-size:12.5px;
    color:var(--accent);
  }
  .legend-val{
    color:var(--text-dim);
    font-size:14.5px;
  }
  @media(max-width:560px){
    .legend-row{grid-template-columns:1fr; gap:6px;}
  }

  .project{
    border-bottom:1px solid var(--line);
    padding:22px 0;
  }
  .project:first-child{ padding-top:0; }
  .project-top{
    display:flex;
    justify-content:space-between;
    align-items:flex-start;
    gap:12px;
    margin-bottom:8px;
  }
  .project-title{
    font-family:'Fraunces', serif;
    font-weight:500;
    font-size:18.5px;
    color:var(--text);
  }
  .project-tag{
    font-family:'JetBrains Mono', monospace;
    font-size:11px;
    color:var(--text-dim);
    white-space:nowrap;
    padding-top:5px;
    letter-spacing:0.04em;
  }
  .project-desc{
    color:var(--text-dim);
    font-size:14.5px;
    margin:0 0 10px;
    max-width:58ch;
  }
  .project-link{
    font-family:'JetBrains Mono', monospace;
    font-size:12.5px;
    color:var(--accent);
  }

  .timeline{ position:relative; padding-left:26px; }
  .timeline::before{
    content:"";
    position:absolute;
    left:6px; top:6px; bottom:6px;
    width:1px;
    background:var(--line-strong);
  }
  .tl-item{ position:relative; margin-bottom:28px; }
  .tl-item:last-child{ margin-bottom:0; }
  .tl-item::before{
    content:"";
    position:absolute;
    left:-26px; top:5px;
    width:9px; height:9px;
    border-radius:50%;
    background:var(--bg);
    border:1.5px solid var(--accent);
  }
  .tl-role{
    font-family:'Fraunces', serif;
    font-weight:500;
    font-size:17px;
    color:var(--text);
    margin:0 0 2px;
  }
  .tl-org{
    font-family:'JetBrains Mono', monospace;
    font-size:12px;
    color:var(--text-dim);
    margin:0 0 8px;
  }
  .tl-desc{
    color:var(--text-dim);
    font-size:14.5px;
    margin:0;
    max-width:58ch;
  }

  ul.plain{ list-style:none; padding:0; margin:0; }
  ul.plain li{
    padding:14px 0;
    border-bottom:1px solid var(--line);
    display:flex;
    justify-content:space-between;
    gap:16px;
    font-size:14.5px;
    color:var(--text-dim);
  }
  ul.plain li:last-child{ border-bottom:none; }
  ul.plain li span.item-name{ color:var(--text); }
  ul.plain li span.item-meta{
    font-family:'JetBrains Mono', monospace;
    font-size:12px;
    color:var(--text-dim);
    text-align:right;
    white-space:nowrap;
  }

  footer{
    margin-top:80px;
    padding-top:32px;
    border-top:1px solid var(--line-strong);
  }
  .footer-name{
    font-family:'Fraunces', serif;
    font-weight:500;
    font-size:19px;
    margin:0 0 4px;
  }
  .footer-role{
    color:var(--text-dim);
    font-size:13.5px;
    margin:0 0 22px;
  }
  .contact-grid{
    display:grid;
    grid-template-columns: 1fr 1fr;
    gap:14px 20px;
    font-family:'JetBrains Mono', monospace;
    font-size:13px;
  }
  .contact-grid .label{
    color:var(--text-dim);
    display:block;
    font-size:10.5px;
    letter-spacing:0.06em;
    text-transform:uppercase;
    margin-bottom:3px;
  }
  @media(max-width:480px){
    .contact-grid{grid-template-columns:1fr;}
